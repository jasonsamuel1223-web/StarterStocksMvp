# Server Environment Variables
# Copy this file to .env and fill in your values

PORT=3001
NODE_ENV=development

# Generate a strong random string for JWT_SECRET — minimum 64 characters, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use the placeholder below in production — replace with your own unique random value.
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_64_chars
# Generate a DIFFERENT random string for the refresh secret:
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_string_minimum_64_chars

# Token expiry durations
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SQLite database file path (relative to server directory)
DB_PATH=./data/starterstocks.db
